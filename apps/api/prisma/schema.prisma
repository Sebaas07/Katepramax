// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rol {
  Admin
  Bodega
  Entregador
}

model Sede {
  id       Int      @id @default(autoincrement())
  nombre   String   @db.VarChar(100)
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en")

  usuarios    Usuario[] // Relación 1:N
  ingresos    Ingreso[]
  inventarios Inventario[]

  @@map("sedes") // Nombre real de la tabla en MySQL
}

model Log {
  id          Int      @id @default(autoincrement())
  accion      String   @db.VarChar(100) // Ejemplo: "LOGIN", "CREAR_USUARIO", "ELIMINAR_PRODUCTO"
  descripcion String   @db.Text // Detalle de la acción
  creadoEn    DateTime @default(now()) @map("creado_en")

  // Relación con el usuario que hizo la acción
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@map("logs")
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombreCompleto String   @map("nombre_completo") @db.VarChar(255)
  usuario        String   @unique @db.VarChar(50)
  clave          String   @db.VarChar(255)
  correo         String   @unique @db.VarChar(150)
  telefono       String   @db.VarChar(20)
  rol            Rol
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @map("creado_en")
  ultimoAcceso   DateTime @default(now()) @map("ultimo_acceso")
  sedeId         Int      @map("sede_id")
  sede           Sede     @relation(fields: [sedeId], references: [id])
  logs           Log[]
  sesions        Sesion[]

  @@map("usuarios") // Nombre real de la tabla en MySQL
}

model Sesion {
  id          Int      @id @default(autoincrement())
  refreshHash String   @map("refresh_hash") @db.VarChar(255)
  activa      Boolean  @default(true)
  ip          String?  @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  creadoEn    DateTime @default(now()) @map("creado_en")
  expiraEn    DateTime @map("expira_en")

  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("sesiones")
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  mensaje   String   @db.Text
  stack     String?  @db.Text
  metodo    String?  @db.VarChar(10) // GET, POST, etc.
  url       String?  @db.VarChar(255)
  usuarioId Int?     @map("usuario_id")
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@map("error_logs")
}

model Inventario {
  id       Int      @id @default(autoincrement())
  fecha    DateTime @db.Date
  semana   Int
  sedeId   Int      @map("sede_id")
  cantidad Int
  costo    Decimal  @db.Decimal(15, 2)
  creadoEn DateTime @default(now()) @map("creado_en")

  sede Sede @relation(fields: [sedeId], references: [id])

  @@index([fecha, semana])
  @@index([sedeId])
  @@map("inventario")
}

model Ingreso {
  id          Int      @id @default(autoincrement())
  fecha       DateTime
  semana      Int
  sedeId      Int
  efectivo    Decimal  @db.Decimal(15, 2)
  cuentas     Decimal  @db.Decimal(15, 2)
  total       Decimal  @db.Decimal(15, 2)
  observacion String?  @db.Text
  createdAt   DateTime @default(now())

  sede Sede @relation(fields: [sedeId], references: [id])

  @@index([fecha, semana])
  @@index([sedeId])
  @@map("ingresos")
}
