// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rol {
  Admin
  AdminBogota
  Oficinista
  Bodega
  Entregador
}

enum EstadoPedido {
  Pendiente
  Asignado
  Entregado
  Cancelado
}

enum EstadoAsignacion {
  Pendiente
  EnRuta
  Entregado
  Fallido
}

enum MetodoPago {
  Efectivo
  Transferencia
  Mixto
  Parcial
  Credito
}

model Sede {
  id       Int      @id @default(autoincrement())
  nombre   String   @db.VarChar(100)
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en")

  usuarios    Usuario[]
  ingresos    Ingreso[]
  inventarios Inventario[]
  stockSedes  StockSede[]
  egresos     Egreso[]
  abonos      Abono[]
  carteras    Cartera[]
  pedidos     Pedido[]
  clientes    Cliente[]
  enviosOrigen  Envio[] @relation("EnvioOrigen")
  enviosDestino Envio[] @relation("EnvioDestino")

  @@map("sedes")
}

model Log {
  id          Int      @id @default(autoincrement())
  accion      String   @db.VarChar(100)
  descripcion String   @db.Text
  creadoEn    DateTime @default(now()) @map("creado_en")

  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@map("logs")
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombreCompleto String   @map("nombre_completo") @db.VarChar(255)
  usuario        String   @unique @db.VarChar(50)
  clave          String   @db.VarChar(255)
  correo         String   @unique @db.VarChar(150)
  telefono       String   @db.VarChar(20)
  rol            Rol
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @map("creado_en")
  ultimoAcceso   DateTime @default(now()) @map("ultimo_acceso")
  sedeId         Int      @map("sede_id")

  sede                   Sede                    @relation(fields: [sedeId], references: [id])
  logs                   Log[]
  sesiones               Sesion[]
  pedidosCreados         Pedido[]                @relation("CreadoPor")
  entregasAsignadas      AsignacionEntrega[]     @relation("Entregador")
  asignacionesRealizadas AsignacionEntrega[]     @relation("AsignadoPor")
  // FIX: una sola relación hacia HistorialEstadoPedido con nombre consistente
  historialEstadoPedidos HistorialEstadoPedido[] @relation("HistorialUsuario")
  enviosCreados          Envio[]                 @relation("EnvioCreador")
  enviosConfirmados      Envio[]                 @relation("EnvioConfirmador")
  enviosCancelados       Envio[]                 @relation("EnvioCancelador")

  @@map("usuarios")
}

model Sesion {
  id          Int      @id @default(autoincrement())
  refreshHash String   @map("refresh_hash") @db.VarChar(255)
  activa      Boolean  @default(true)
  ip          String?  @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  creadoEn    DateTime @default(now()) @map("creado_en")
  expiraEn    DateTime @map("expira_en")

  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("sesiones")
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  mensaje   String   @db.Text
  stack     String?  @db.Text
  metodo    String?  @db.VarChar(10)
  url       String?  @db.VarChar(255)
  usuarioId Int?     @map("usuario_id")
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@map("error_logs")
}

model Inventario {
  id                Int      @id @default(autoincrement())
  fecha             DateTime @map("fecha")
  semana            Int
  cantidadIngresada Int      @default(0) @map("cantidad_ingresada")
  costoUnitario     Decimal  @default(0.00) @map("costo_unitario") @db.Decimal(12, 2)
  tipo              String   @default("entrada") @db.VarChar(20)
  nota              String?  @db.Text
  creadoEn          DateTime @default(now()) @map("creado_en")

  sedeId     Int @map("sede_id")
  productoId Int @map("producto_id")

  sede     Sede     @relation(fields: [sedeId], references: [id])
  producto Producto @relation(fields: [productoId], references: [codigo])

  @@index([sedeId, productoId, fecha])
  @@index([semana])
  @@index([fecha])
  @@map("inventarios")
}

model Producto {
  codigo             Int      @id @default(autoincrement())
  sku                String   @unique @db.VarChar(30)
  descripcion        String   @db.VarChar(255)
  precioCosto        Decimal  @default(0.00) @map("precio_costo") @db.Decimal(12, 2)
  precioVenta        Decimal  @default(0.00) @map("precio_venta") @db.Decimal(12, 2)
  precioMayoreo      Decimal? @map("precio_mayoreo") @db.Decimal(12, 2)
  porcentajeGanancia Decimal  @default(0.00) @map("porcentaje_ganancia") @db.Decimal(5, 2)
  departamento       String?  @default("Otros") @db.VarChar(100)
  stockMinimo        Int      @default(0) @map("stock_minimo")
  activo             Boolean  @default(true)
  creadoEn           DateTime @default(now()) @map("creado_en")
  actualizadoEn      DateTime @updatedAt @map("actualizado_en")

  proveedorId Int?       @map("proveedor_id")
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  // FIX: una sola relación hacia PedidoDetalle con nombre consistente
  pedidoDetalles PedidoDetalle[] @relation("DetalleProducto")
  inventarios    Inventario[]
  stockSedes     StockSede[]
  envioDetalles  EnvioDetalle[]

  @@map("productos")
}

model SkuContador {
  prefijo      String @id @db.VarChar(10)
  ultimoNumero Int    @default(0) @map("ultimo_numero")

  @@map("sku_contadores")
}

model StockSede {
  id            Int      @id @default(autoincrement())
  sedeId        Int      @map("sede_id")
  productoId    Int      @map("producto_id")
  stockActual   Int      @default(0) @map("stock_actual")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  sede     Sede     @relation(fields: [sedeId], references: [id])
  producto Producto @relation(fields: [productoId], references: [codigo])

  @@unique([sedeId, productoId])
  @@map("stock_sedes")
}

model Proveedor {
  id       Int      @id @default(autoincrement())
  nombre   String   @db.VarChar(100)
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en")

  productos Producto[]
  abonos    Abono[]

  @@map("proveedores")
}

model HistorialEstadoPedido {
  id         Int          @id @default(autoincrement())
  pedidoId   Int          @map("pedido_id")
  estado     EstadoPedido @map("estado")
  cambiadoEn DateTime     @default(now()) @map("cambiado_en")
  usuarioId  Int?         @map("usuario_id")

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  // FIX: una sola relación con nombre consistente hacia Usuario
  usuario Usuario? @relation("HistorialUsuario", fields: [usuarioId], references: [id])

  @@index([pedidoId])
  @@index([cambiadoEn])
  @@map("historial_estados_pedido")
}

model Pedido {
  id            Int          @id @default(autoincrement())
  clienteId     Int          @map("cliente_id")
  sedeId        Int          @map("sede_id")
  estado        EstadoPedido @default(Pendiente)
  direccion     String?      @db.VarChar(255)
  observaciones String?      @db.Text
  totalRecibido Decimal      @default(0.00) @map("total_recibido") @db.Decimal(12, 2)
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  creadoPorId Int @map("creado_por")

  sede    Sede    @relation(fields: [sedeId], references: [id])
  creador Usuario @relation("CreadoPor", fields: [creadoPorId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])

  detalles     PedidoDetalle[]
  asignaciones AsignacionEntrega[]
  historial    HistorialEstadoPedido[]

  @@map("pedidos")
}

model PedidoDetalle {
  id             Int     @id @default(autoincrement())
  pedidoId       Int     @map("pedido_id")
  productoId     Int     @map("producto_id")
  productoNombre String  @map("producto_nombre") @db.VarChar(255)
  cantidad       Int     @db.Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  // FIX: una sola relación con nombre consistente, productoCodigo eliminado
  producto Producto @relation("DetalleProducto", fields: [productoId], references: [codigo])

  @@map("pedido_detalles")
}

model AsignacionEntrega {
  id                   Int              @id @default(autoincrement())
  pedidoId             Int              @map("pedido_id")
  entregadorId         Int              @map("entregador_id")
  asignadoPorId        Int              @map("asignado_por")
  asignadoEn           DateTime         @default(now()) @map("asignado_en")
  fechaConfirmada      DateTime?        @map("confirmado_en")
  montoCobrado         Decimal?         @map("monto_cobrado") @db.Decimal(12, 2)
  montoEfectivo        Decimal?         @map("monto_efectivo") @db.Decimal(12, 2)
  montoTransferencia   Decimal?         @map("monto_transferencia") @db.Decimal(12, 2)
  abonoDeuda           Decimal          @default(0.00) @map("abono_deuda") @db.Decimal(12, 2)
  metodoPago           MetodoPago?      @map("metodo_pago")
  observacionesEntrega String?          @map("observaciones_entrega") @db.Text
  estado               EstadoAsignacion @default(Pendiente)

  pedido     Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  entregador Usuario @relation("Entregador", fields: [entregadorId], references: [id])
  asignador  Usuario @relation("AsignadoPor", fields: [asignadoPorId], references: [id])

  @@map("asignaciones_entrega")
}

model Cliente {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(150)
  limiteCredito Decimal  @default(10000000.00) @map("limite_credito") @db.Decimal(12, 2)
  saldoDeuda    Decimal  @default(0.00) @map("saldo_deuda") @db.Decimal(12, 2)
  telefono      String?  @db.VarChar(20)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Sede a la que pertenece el cliente. Opcional para no romper los
  // clientes ya existentes (creados antes de este campo); un cliente
  // sin sede asignada simplemente no aparece en los reportes filtrados
  // por sede, pero sí en la vista "Todas".
  sedeId Int?  @map("sede_id")
  sede   Sede? @relation(fields: [sedeId], references: [id])

  pedidos Pedido[]

  @@index([nombre])
  @@index([telefono])
  @@index([sedeId])
  @@map("clientes")
}

model Ingreso {
  id            Int      @id @default(autoincrement())
  fecha         DateTime
  semana        Int
  sedeId        Int
  efectivo      Decimal  @db.Decimal(15, 2)
  cuentas       Decimal  @db.Decimal(15, 2)
  total         Decimal  @db.Decimal(15, 2)
  observacion   String?  @db.Text
  fechaCreacion DateTime @default(now()) @map("creado_en")

  sede Sede @relation(fields: [sedeId], references: [id])

  @@index([fecha, semana])
  @@index([sedeId])
  @@map("ingresos")
}

model Egreso {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @db.Date
  semana      Int
  concepto    String   @db.VarChar(200)
  total       Decimal  @default(0) @db.Decimal(15, 2)
  observacion String?  @db.VarChar(500)
  creadoEn    DateTime @default(now()) @map("creado_en")

  sedeId Int  @map("sede_id")
  sede   Sede @relation(fields: [sedeId], references: [id])

  @@index([fecha, semana])
  @@index([sedeId])
  @@map("egresos")
}

model Abono {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @db.Date
  semana      Int
  valorPagado Decimal  @map("valor_pagado") @db.Decimal(15, 2)
  observacion String?  @db.VarChar(500)
  creadoEn    DateTime @default(now()) @map("creado_en")

  proveedorId Int @map("proveedor_id")
  sedeId      Int @map("sede_id")

  proveedor Proveedor @relation(fields: [proveedorId], references: [id])
  sede      Sede      @relation(fields: [sedeId], references: [id])

  @@index([fecha, semana])
  @@index([proveedorId])
  @@index([sedeId])
  @@map("abonos")
}

model Cartera {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @db.Date
  semana        Int
  saldoDia      Decimal  @map("saldo_dia") @db.Decimal(15, 2)
  saldoAnterior Decimal  @default(0.00) @map("saldo_anterior") @db.Decimal(15, 2)
  variacion     Decimal  @default(0.00) @db.Decimal(15, 2)
  creadoEn      DateTime @default(now()) @map("creado_en")

  sedeId Int  @map("sede_id")
  sede   Sede @relation(fields: [sedeId], references: [id])

  @@unique([sedeId, fecha])
  @@index([semana])
  @@index([fecha])
  @@map("cartera")
}

enum EstadoEnvio {
  Pendiente
  Confirmado
  ConNovedad
  Cancelado
}

// Guía de envío de mercancía entre sedes. Un Admin/AdminBogota crea un envío
// hacia una o varias sedes destino (una fila Envio por cada sede destino, cada
// una con su propia lista de productos/cantidades). Al crear, se descuenta el
// stock de la sede origen y se registra una salida en Inventario. Al confirmar
// la recepción en la sede destino, se registra la entrada correspondiente en
// Inventario (y se crea el StockSede si aún no existía para ese producto en
// esa sede) usando la cantidad realmente recibida, no la enviada.
model Envio {
  id                   Int         @id @default(autoincrement())
  sedeOrigenId         Int         @map("sede_origen_id")
  sedeDestinoId        Int         @map("sede_destino_id")
  creadoPorId          Int         @map("creado_por")
  confirmadoPorId      Int?        @map("confirmado_por")
  canceladoPorId       Int?        @map("cancelado_por")
  estado               EstadoEnvio @default(Pendiente)
  observaciones        String?     @map("observaciones") @db.Text
  observacionRecepcion String?     @map("observacion_recepcion") @db.Text
  fechaEnvio           DateTime    @default(now()) @map("fecha_envio")
  fechaConfirmacion    DateTime?   @map("fecha_confirmacion")
  fechaCancelacion     DateTime?   @map("fecha_cancelacion")

  sedeOrigen  Sede     @relation("EnvioOrigen", fields: [sedeOrigenId], references: [id])
  sedeDestino Sede     @relation("EnvioDestino", fields: [sedeDestinoId], references: [id])
  creador     Usuario  @relation("EnvioCreador", fields: [creadoPorId], references: [id])
  confirmador Usuario? @relation("EnvioConfirmador", fields: [confirmadoPorId], references: [id])
  cancelador  Usuario? @relation("EnvioCancelador", fields: [canceladoPorId], references: [id])

  detalles EnvioDetalle[]

  @@index([sedeDestinoId, estado])
  @@index([sedeOrigenId])
  @@map("envios")
}

model EnvioDetalle {
  id               Int     @id @default(autoincrement())
  envioId          Int     @map("envio_id")
  productoId       Int     @map("producto_id")
  cantidadEnviada  Int     @map("cantidad_enviada")
  cantidadRecibida Int?    @map("cantidad_recibida")
  observacion      String? @map("observacion") @db.VarChar(500)

  envio    Envio    @relation(fields: [envioId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [codigo])

  @@index([envioId])
  @@map("envio_detalles")
}
