{
  "name": "katepramax-monorepo",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev": "concurrently -n \"API,WEB\" -c \"magenta,cyan\" \"pnpm dev:api\" \"pnpm dev:web\"",
    "install-all": "pnpm install",
    "security:test": "snyk test --all-projects",
    "security:monitor": "snyk monitor"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "snyk": "^1.1307.0"
  },
  "dependencies": {
    "react-hot-toast": "^2.6.0"
  }
}
